{
  "macros": {
    "open-add-files": [
      {
        "goto": "/"
      },
      {
        "when": "wide",
        "click": "role=button[name=\"All cases\"s]"
      },
      {
        "when": "narrow",
        "click": "role=button[name=/^More/]"
      },
      {
        "when": "narrow",
        "click": "role=menuitem[name=\"All cases\"s]"
      },
      {
        "click": "role=button[name=\"Create a new case\"]"
      },
      {
        "waitFor": "text=Nothing is saved until the last step."
      },
      {
        "fill": [
          "role=textbox[name=\"Case name\"]",
          "Audit files case"
        ]
      },
      {
        "click": "role=button[name=\"Next\"s]"
      },
      {
        "waitFor": "role=heading[name=\"Choose what to look at\"]"
      },
      {
        "click": "role=button[name=/^Files/]"
      },
      {
        "waitFor": "role=heading[name=\"Add files by type\"]"
      }
    ]
  },
