    {
      "id": "p10-files-1",
      "phase": "P10",
      "note": "Add files: an IIS log from each of two computers and a log4net-style .txt with no telling name (fixture uploads through the real file input). Shows what each row says about its kind and its computer.",
      "narrow": true,
      "steps": [
        {
          "macro": "open-add-files"
        },
        {
          "upload": [
            "input[aria-label=\"Choose files to import\"]",
            [
              "iis-web-01",
              "iis-web-02",
              "app-no-name"
            ]
          ]
        },
        {
          "waitFor": "[data-file=\"orders.txt\"]"
        },
        {
          "scrollTo": "[data-file=\"orders.txt\"]"
        }
      ]
    },
    {
      "id": "p10-files-2",
      "phase": "P10",
      "note": "Add files: files that are refused or not recognised (an unknown binary, a compressed file, an empty file, a plain note) next to one good IIS log.",
      "narrow": true,
      "steps": [
        {
          "macro": "open-add-files"
        },
        {
          "upload": [
            "input[aria-label=\"Choose files to import\"]",
            [
              "iis-web-01",
              "binary",
              "compressed",
              "empty",
              "notes"
            ]
          ]
        },
        {
          "waitFor": "[data-file=\"blob.bin\"]"
        }
      ]
    },
    {
      "id": "p10-files-3",
      "phase": "P10",
      "note": "Add files: the other kinds (HTTP error log, SQL Server error log, IIS log) and what each says about its computer.",
      "narrow": true,
      "steps": [
        {
          "macro": "open-add-files"
        },
        {
          "upload": [
            "input[aria-label=\"Choose files to import\"]",
