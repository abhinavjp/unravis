# Unravis remote Salt access: connection settings.
# This is the TEMPLATE. The real file lives OUTSIDE the repo at
#   %USERPROFILE%\.unravis-remote\.env
# and is created for you by tools\remote\Initialize-RemoteEnv.ps1. Type your values there yourself.
# Never paste the password anywhere else (not in chat, not in a commit, not on a command line).
# Format: KEY=VALUE, one per line. Lines starting with # are comments. No quotes needed. No inline comments.

# --- Where to connect (required) -------------------------------------------------
# The server that runs the Salt master (IP address or DNS name).
SALT_MASTER_HOST=
# SSH port. 22 unless your server uses another one.
SSH_PORT=22
# The SSH user name.
SSH_USER=

# --- How to sign in (set ONE of the two; a key is safer than a password) ----------
# Password (OpenSSH asks for it through a tiny helper; it is never put on a command line).
SSH_PASSWORD=
# OR the full path to an OpenSSH private key file (not a PuTTY .ppk; convert it with PuTTYgen:
# Conversions > Export OpenSSH key). Leave SSH_PASSWORD empty when you use a key.
SSH_KEY_PATH=

# --- Trusting the server (required before the first connection) -------------------
# The server's host key fingerprint, like SHA256:abc... . Ask the server admin for it, or run
#   Invoke-RemoteSalt.ps1 -Action ShowHostKey
# and compare what it prints with what the admin gives you. Then paste it here.
SSH_HOST_KEY_FINGERPRINT=

# --- What Salt may touch ----------------------------------------------------------
# Salt minion ids this tool may target, comma separated (exact ids, no wildcards). Run
#   Invoke-RemoteSalt.ps1 -Action Keys
# to list them. Leave empty until you know them; only the Keys/Check actions work then.
SALT_MINION_TARGETS=
# Run salt as root through "sudo -n" (true), or directly (false). Salt on the master usually needs root.
SALT_USE_SUDO=true
# Only files under these folders can be read (comma separated). Use the real Unravis/Blackbox log folders.
# Examples:  C:\ProgramData\Unravis\logs,C:\ProgramData\Unravis\blackbox   or   /var/log/salt,/var/log/unravis
# For UpdateStatus on BG-SRV-UK-01, append these folders to your own REMOTE_LOG_PATHS:
# D:\UnravisBlackbox,D:\UnravisUpdate,C:\Users\btlsupport1\AppData\Local\Programs\Unravis
REMOTE_LOG_PATHS=

# --- Safety -----------------------------------------------------------------------
# readonly (default, safe) or write. Service changes, Blackbox changes, and the fixed recipes in
# docs/remote/UPDATE.md require a separate request and approval before each action runs.
REMOTE_MODE=readonly
