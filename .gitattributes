# Normalise line endings: store LF and check out LF.
# Fixes the CRLF-only test helpers that broke CI on windows-2022 (CI-01).
* text=auto eol=lf

# Windows batch files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalise line endings or diff.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.exe binary
*.dll binary
*.wasm binary
*.pdf binary
*.bin binary
*.dat binary