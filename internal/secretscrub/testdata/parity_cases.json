    "FAKE2",
    "FAKE3</PrivateKey>",
    "after"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2",
    "FAKE3"
   ]
  },
  {
   "name": "N7 text sticks to the closing quote",
   "lines": [
    "DB_PASSWORD=\"FAKE1",
    "FAKE2\"FAKEPW"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2",
    "FAKEPW"
   ]
  },
  {
   "name": "N3 block opens beside a stray tag",
   "lines": [
    "<a x=\"1\" <b> password: |",
    "  FAKEPW",
    "  FAKEPW2"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N3 next-line value opens beside a stray tag",
   "lines": [
    "<a x=\"1\" <b> DB_PASSWORD=",
    "FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "R3-1 key opened inside a dropped tag (next line)",
   "lines": [
    "see <a",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "DB_PASSWORD=",
    "FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "R3-1 key opened inside a dropped tag (block)",
   "lines": [
    "see <a",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "o",
    "password: |",
    "  FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  }
 ],
 "expectUnchanged": [
  {
   "name": "sentence after a bare key",
   "lines": [
    "Password:",
    "sudo: 3 incorrect password attempts"
   ]
  },
  {
   "name": "test runner line after a key",
   "lines": [
    "Password:",
    "--- FAIL: TestLogin"
   ]
  },
  {
   "name": "ordinary link",
   "lines": [
    "see <a href=\"x\">link</a>"
   ]
  },
  {
   "name": "stray tag opener then ordinary lines",
   "lines": [
    "x <a",
    "ordinary line 0",
    "ordinary line 1",
    "ordinary line 2"
   ]
  }
 ]
