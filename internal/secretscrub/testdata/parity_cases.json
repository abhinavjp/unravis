    "DB_PASSWORD=",
    "FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N4 second key opens a quote",
   "lines": [
    "{\"token\":\"FAKE0\",\"password\":\"FAKE1",
    "FAKE2\"}"
   ],
   "secrets": [
    "FAKE0",
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N4 second key has the value on the next line",
   "lines": [
    "token=FAKE0 DB_PASSWORD=",
    "FAKEPW"
   ],
   "secrets": [
    "FAKE0",
    "FAKEPW"
   ]
  },
  {
   "name": "N4 second key opens a block",
   "lines": [
    "secret=FAKE0 password: |",
    "  FAKEPW"
   ],
   "secrets": [
    "FAKE0",
    "FAKEPW"
   ]
  },
  {
   "name": "N5 key attribute then value on the next line",
   "lines": [
    "<add key=\"password\"",
    "value=\"FAKEPW\" />"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N5 key attribute, upper case name",
   "lines": [
    "<add key=\"DB_PASSWORD\"",
    "  value=\"FAKEPW\"/>"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N5 attribute value open over the line",
   "lines": [
    "<add key=\"password\" value=\"FAKE1",
    "FAKE2\" />"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N5 connection string open over the line",
   "lines": [
    "<connectionStrings><add name=\"x\" connectionString=\"Server=a;Password=FAKE1",
    "FAKE2;\" />"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N5 .NET settings form",
   "lines": [
    "<setting name=\"Password\"",
    "         serializeAs=\"String\">",
    "  <value>FAKEPW</value>",
    "</setting>"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N5 bare tag name, key on the next line",
   "lines": [
    "<add",
    "  key=\"ApiToken\"",
    "  value=\"FAKEPW\" />"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N6 element text goes on",
   "lines": [
    "<Password>FAKE1",
    "FAKE2</Password>"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N6 element text over three lines",
   "lines": [
