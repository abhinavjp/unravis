{
 "about": "Shared by the Go tests (internal/secretscrub, internal/releasedash) and the PowerShell test (tools/release/Test-ReleaseManager.ps1). Each case is the lines of one log, read in order by one reader. No string in secrets may appear in any output line. Lines of expectUnchanged must come out as they went in.",
 "cases": [
  {
   "name": "F1 attribute value holds a key (1)",
   "lines": [
    "<add key=\"password\" value=\"password=\"FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F1 attribute value holds a key (2)",
   "lines": [
    "<add key=\"DbPassword\" value=\"DB_PASSWORD=\" FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F1 attribute value holds a key (3)",
   "lines": [
    "<setting name=\"password\" value=\"secret=\" FAKEPW"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F2 block after a quote closes",
   "lines": [
    "        DB_PASSWORD=\"FAKE1",
    "FAKE2\" password: |",
    "  FAKEPW",
    "  FAKEPW2"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2",
    "FAKEPW"
   ]
  },
  {
   "name": "F2 block after a bracket closes",
   "lines": [
    "        {\"password\":[",
    "\"FAKE1\"], \"secret\": |",
    "  FAKEPW",
    "  FAKEPW2"
   ],
   "secrets": [
    "FAKE1",
    "FAKEPW"
   ]
  },
  {
   "name": "F3 split tag then colon key, element text",
   "lines": [
    "<Password client_secret:",
    ">FAKEPW</Password>"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F3 split tag then colon key, attribute",
   "lines": [
    "<Password token:",
    "value=\"FAKEPW\">FAKEPW</Password>"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F4 close tag in another case",
   "lines": [
    "<Password>",
    "FAKEPW</password>",
    "after"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "F5 escaped quote in a JSON value",
   "lines": [
    "{\"password\":\"a\\\"b FAKEPW\"}"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N2 quote beats a tag opened inside the value",
   "lines": [
    "DB_PASSWORD=\"FAKE1 <a",
    "FAKE2\" tail"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N2 quote beats a tag, JSON string",
   "lines": [
    "{\"password\": \"FAKE1 <s",
    "FAKE2\"}"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N2 bracket beats a tag",
   "lines": [
    "{\"credential\":[\"FAKE1 <p",
    "\"FAKE2\"]}"
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N3 block under an open tag",
   "lines": [
    "see <a",
    "password: |",
    "  FAKEPW",
    "  FAKEPW2"
   ],
   "secrets": [
    "FAKEPW"
   ]
  },
  {
   "name": "N3 quote under an open tag",
   "lines": [
    "see <a",
    "password: \"FAKE1",
    "FAKE2\""
   ],
   "secrets": [
    "FAKE1",
    "FAKE2"
   ]
  },
  {
   "name": "N3 next line under an open tag",
